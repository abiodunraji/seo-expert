---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

const {
  title,
  description,
  path = '/',
  ogType = 'website',
  breadcrumb = null,
} = Astro.props;

const site = 'https://iwanstepanova.com';
const canonical = new URL(path, site).href;
const GTM = 'GTM-PZXB5GSC';

const knowsAbout = [
  'SEO',
  'Local SEO',
  'SEO-content',
  'Technische SEO',
  'AI-vindbaarheid',
  'GA4',
  'Google Tag Manager',
];
const address = {
  '@type': 'PostalAddress',
  addressLocality: 'Alkmaar',
  addressRegion: 'Noord-Holland',
  addressCountry: 'NL',
};
const orgDescription =
  'Brede SEO-specialist, beschikbaar voor interim- en freelanceopdrachten in Nederland, remote of op locatie. Strategie en uitvoering over de volle breedte van SEO, met ervaring op enterprise-niveau in bureaucontext.';

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site}/#iwan`,
      name: 'Iwan Stepanova',
      url: site,
      image: `${site}/images/iwan.jpg`,
      jobTitle: 'SEO- & GEO-specialist',
      description: orgDescription,
      email: 'hallo@iwanstepanova.com',
      telephone: '+31623872013',
      knowsAbout,
      address,
      sameAs: ['https://www.linkedin.com/in/iwan-stepanova-seo/'],
      worksFor: { '@id': `${site}/#service` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site}/#service`,
      name: 'Iwan Stepanova',
      description: orgDescription,
      url: site,
      image: `${site}/images/iwan.jpg`,
      email: 'hallo@iwanstepanova.com',
      telephone: '+31623872013',
      knowsAbout,
      address,
      areaServed: { '@type': 'Country', name: 'Nederland' },
      founder: { '@id': `${site}/#iwan` },
      sameAs: ['https://www.linkedin.com/in/iwan-stepanova-seo/'],
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: site,
      name: 'Iwan Stepanova',
      inLanguage: 'nl-NL',
      publisher: { '@id': `${site}/#iwan` },
    },
  ],
};

const breadcrumbSchema = breadcrumb
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: breadcrumb, item: canonical },
      ],
    }
  : null;
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Iwan Stepanova" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Iwan Stepanova" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="preload" href="/fonts/Excon-Medium.woff2" as="font" type="font/woff2" crossorigin />

  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'granted',
      security_storage: 'granted',
      wait_for_update: 500
    });
    try {
      var c = localStorage.getItem('cookie-consent');
      if (c === 'granted') {
        gtag('consent', 'update', {
          ad_storage: 'granted', ad_user_data: 'granted',
          ad_personalization: 'granted', analytics_storage: 'granted'
        });
      }
    } catch (e) {}
  </script>

  <script is:inline define:vars={{ GTM }}>
    (function () {
      var loaded = false;
      function loadGTM() {
        if (loaded) return; loaded = true;
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',GTM);
      }
      if ('requestIdleCallback' in window) { requestIdleCallback(loadGTM, { timeout: 3200 }); }
      else { window.addEventListener('load', function () { setTimeout(loadGTM, 1400); }); }
      ['scroll','click','keydown','touchstart','mousemove'].forEach(function (e) {
        window.addEventListener(e, loadGTM, { once: true, passive: true });
      });
    })();
  </script>
</head>
<body>
  <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <div class="grain"></div>
  <slot />
  <Footer />
  <CookieBanner />
</body>
</html>
