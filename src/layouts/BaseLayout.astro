---
import type { ComponentProps } from 'astro/types';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  image?: string;
}

const { title, description, canonicalURL, image } = Astro.props;
const defaultDescription =
  'Lokaal vindbaar worden, zonder fluff. Local SEO voor dienstverleners en MKB-bedrijven die hun klanten uit de eigen regio halen.';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts are self-hosted via @fontsource (imported in global.css) -->

    <SEO
      title={title}
      description={description ?? defaultDescription}
      canonicalURL={canonicalURL}
      image={image}
    />

    <!-- JSON-LD ProfessionalService Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Iwan Stepanova",
      "description": "Local SEO specialist voor MKB en dienstverleners in Nederland.",
      "url": "https://iwanstepanova.com/",
      "email": "hallo@iwanstepanova.com",
      "telephone": "+31623872013",
      "areaServed": "Nederland",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Alkmaar",
        "addressCountry": "NL"
      },
      "sameAs": [
        "https://www.linkedin.com/in/iwan-stepanova-seo/"
      ]
    })} />
  </head>
  <body class="bg-neutral-100 text-primary min-h-screen flex flex-col antialiased">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
