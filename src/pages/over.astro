---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { url } from '../lib/urls';
---

<BaseLayout
  title="Over Iwan Stepanova"
  description="Brede SEO- en GEO-specialist. Zelfstandig sinds begin 2026, na ruim drie jaar SEO waarvan een deel op enterprise-niveau bij het grootste marketingbureau van de Benelux."
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-20 lg:py-28 bg-surface-alt dot-grid">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-accent/5 rounded-full blur-[120px]"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <span class="section-label">Over Iwan</span>
          <h1
            class="font-semibold text-4xl lg:text-5xl xl:text-6xl mt-5 tracking-tight leading-[1.1]"
          >
            <span class="font-display italic text-primary block">Iwan</span>
            <span class="font-sans text-primary-light block">Stepanova</span>
          </h1>
          <p class="font-sans text-lg lg:text-xl text-neutral-500 mt-6 leading-relaxed">
            Brede SEO- en GEO-specialist. Zelfstandig sinds begin 2026, na ruim drie jaar SEO
            waarvan een deel op enterprise-niveau. Beschikbaar voor interim en freelance.
          </p>
        </div>

        <div class="relative">
          <div class="absolute inset-0 bg-accent/5 rounded-2xl blur-3xl"></div>
          <div
            class="relative bg-surface rounded-2xl border border-neutral-300 overflow-hidden shadow-soft"
          >
            <img
              src={url('/images/iwan.png')}
              alt="Iwan Stepanova"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mijn achtergrond -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Mijn achtergrond</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Van copywriter</span>
          <span class="font-sans font-semibold text-primary-light"> naar SEO en GEO.</span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Ik begon op mijn zeventiende als freelance copywriter en schreef voor bedrijven die hun
            klanten online moesten zien te bereiken. Vanuit die achtergrond ben ik doorgegroeid naar
            SEO. Dat het werk met taal en inhoud begon, is de reden dat content een van mijn sterkste
            kanten is gebleven, ook toen het breder en technischer werd.
          </p>
          <p>
            Ik heb bij meerdere bureaus gewerkt, waaronder Youvia, onderdeel van FCR Media, het
            grootste marketingbureau van de Benelux. Daar deed ik enterprise SEO-werk en werkte ik
            aan merken als L'Oréal, ANWB, Etos, Action, Interpolis en Papa John's, uitgevoerd binnen
            bureauwerk. Ik specialiseerde me in local SEO en GEO, en gaf trainingen en webinars over
            die onderwerpen voor andere bureaus.
          </p>
          <p>
            Sinds begin 2026 werk ik fulltime als zelfstandige. Ik ben nu beschikbaar voor interim-
            en freelanceopdrachten, voor bureaus, in-house teams en grotere merken die tijdelijk of
            op projectbasis SEO- of GEO-expertise nodig hebben.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mijn aanpak -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl mb-16">
        <span class="section-label">Mijn aanpak</span>
        <h2 class="text-3xl lg:text-4xl mt-5 tracking-tight">
          <span class="font-display italic text-primary">Wat je van mij</span>
          <span class="font-sans font-semibold text-primary-light"> kunt verwachten.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card card-signal">
          <h3 class="font-sans font-semibold text-xl text-primary mb-3">
            Breed, met GEO als scherpste punt
          </h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Ik werk over de volle breedte van SEO: technische audits, contentstrategie, on-page en
            GEO. Content is mijn sterkste discipline. GEO is mijn scherpste onderscheidende punt,
            waar ik kritisch en op bewijs gebaseerd te werk ga in plaats van mee te gaan in de hype.
          </p>
        </div>
        <div class="card card-signal">
          <h3 class="font-sans font-semibold text-xl text-primary mb-3">Strategie, geen trucjes</h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Ik lever geen losse ingrepen die op de korte termijn iets lijken te doen, maar een
            onderbouwde strategie met keuzes die standhouden. De vertaling van analyse naar wat een
            opdrachtgever kan begrijpen en uitvoeren, is de kern van mijn werk.
          </p>
        </div>
        <div class="card card-signal">
          <h3 class="font-sans font-semibold text-xl text-primary mb-3">Geen jargon, wel uitleg</h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            SEO heeft genoeg vakjargon om een gesprek dicht te timmeren. Ik leg uit wat ik doe en
            waarom, in gewone taal. Niet om indruk te maken, maar zodat een team zelf kan beoordelen
            of de keuzes hout snijden en er zelf mee verder kan.
          </p>
        </div>
        <div class="card card-signal">
          <h3 class="font-sans font-semibold text-xl text-primary mb-3">
            Zelfstandig binnen je team
          </h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Ik stap in waar de capaciteit of de specialistische kennis tijdelijk ontbreekt, werk
            zelfstandig binnen een groter team of bureau, en draag het werk zo over dat het na de
            opdracht blijft staan. Remote of op locatie.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Slot CTA -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div
        class="relative bg-surface-alt rounded-2xl border border-neutral-300 p-10 lg:p-16 text-center overflow-hidden shadow-soft"
      >
        <div
          class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-accent/10 rounded-full blur-[100px]"
        >
        </div>
        <div class="relative">
          <h2 class="text-3xl lg:text-4xl tracking-tight">
            <span class="font-display italic text-primary">Op zoek naar tijdelijke</span>
            <span class="font-sans font-semibold text-primary-light">
              SEO- of GEO-capaciteit?
            </span>
          </h2>
          <p class="font-sans text-neutral-500 mt-6 max-w-2xl mx-auto leading-relaxed text-lg">
            Plan een gesprek van een half uur. We nemen door wat je nodig hebt en hoe ik zou
            instappen, remote of op locatie.
          </p>
          <div class="mt-8">
            <Button href={url('/contact/')} variant="primary" size="lg">
              Plan een gesprek
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
