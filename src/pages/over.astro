---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { url } from '../lib/urls';
---

<BaseLayout
  title="Over Iwan Stepanova"
  description="Iwan Stepanova, local SEO specialist. Zelfstandig sinds 2026, na jaren agency-werk bij toonaangevende Nederlandse SEO-bureaus."
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-20 lg:py-28 bg-surface-alt dot-grid">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-accent/5 rounded-full blur-[120px]"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <span class="section-label">Over Iwan</span>
          <h1
            class="font-semibold text-4xl lg:text-5xl xl:text-6xl mt-5 tracking-tight leading-[1.1]"
          >
            <span class="font-display italic text-primary block">Iwan</span>
            <span class="font-sans text-primary-light block">Stepanova</span>
          </h1>
          <p class="font-sans text-lg lg:text-xl text-neutral-500 mt-6 leading-relaxed">
            Local SEO specialist. Zelfstandig sinds 2026, na jaren agency-werk bij toonaangevende
            Nederlandse SEO-bureaus.
          </p>
        </div>

        <div class="relative">
          <div class="absolute inset-0 bg-accent/5 rounded-2xl blur-3xl"></div>
          <div
            class="relative bg-surface rounded-2xl border border-neutral-300 overflow-hidden shadow-soft"
          >
            <img
              src={url('/images/iwan.png')}
              alt="Iwan Stepanova"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mijn achtergrond -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Mijn achtergrond</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Hoe ik in local SEO</span>
          <span class="font-sans font-semibold text-primary-light"> terechtkwam.</span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Ik begon als freelance copywriter en schreef voor bedrijven die hun klanten online
            moesten zien te bereiken. Zo kwam ik vanzelf bij SEO terecht. Niet als theorie, maar
            als de praktische vraag: hoe zorg je dat de juiste mensen je vinden op het moment dat
            ze zoeken?
          </p>
          <p>
            Die vraag bracht me bij meerdere Nederlandse SEO-bureaus, waar ik me steeds verder
            specialiseerde. Bij het grootste marketingbureau van de Benelux kwam mijn focus
            uiteindelijk op local SEO te liggen, en op de optimalisatie voor AI-zoekmachines. Ik
            gaf trainingen en webinars over die onderwerpen voor andere bureaus en freelancers, en
            zag van dichtbij hoe lokale bedrijven door heel Nederland worstelden met dezelfde
            uitdaging: een sterke praktijk of zaak, een goede dienst, maar online slecht vindbaar.
          </p>
          <p>
            In 2026 ben ik voor mezelf begonnen om die uitdaging op te lossen zoals ik denk dat
            het hoort. Met aandacht per klant, een aanpak die zich richt op wat lokaal het meeste
            oplevert, en samenwerkingen die de tijd krijgen om écht resultaat te leveren.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mijn aanpak -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl mb-16">
        <span class="section-label">Mijn aanpak</span>
        <h2 class="text-3xl lg:text-4xl mt-5 tracking-tight">
          <span class="font-display italic text-primary">Wat je van mij</span>
          <span class="font-sans font-semibold text-primary-light"> kunt verwachten.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card card-signal">
          <h3 class="font-sans font-semibold text-xl text-primary mb-3">
            Specialist, geen generalist
          </h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Local SEO is mijn vakgebied. Niet een van de zeven diensten die ik aanbied, maar de
            kern van wat ik doe. Dat maakt mijn aanpak dieper en gerichter dan een breed SEO-bureau
            dat ook wat lokaal werk doet.
          </p>
        </div>
        <div class="card card-signal">
          <h3 class="font-sans font-semibold text-xl text-primary mb-3">Direct contact met mij</h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Geen accountmanager, geen tussenlaag. Je werkt rechtstreeks met de specialist die het
            werk uitvoert. Korte lijnen, snelle reacties, en helderheid over wat er gebeurt en
            waarom.
          </p>
        </div>
        <div class="card card-signal">
          <h3 class="font-sans font-semibold text-xl text-primary mb-3">Geen jargon, wel uitleg</h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Local SEO heeft genoeg vakjargon om een gesprek dicht te timmeren. Ik kies ervoor om
            uit te leggen wat ik doe en waarom. Niet om je te beïndrukken, maar zodat je zelf kunt
            beoordelen of het hout snijdt.
          </p>
        </div>
        <div class="card card-signal">
          <h3 class="font-sans font-semibold text-xl text-primary mb-3">Langdurig, niet kortdurig</h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Local SEO werkt het best als langdurige samenwerking. Ik werk daarom met vaste
            maandtarieven, maandelijks opzegbaar maar bedoeld voor de lange termijn. Vertrouwen
            verdien ik elke maand opnieuw.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Slot CTA -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div
        class="relative bg-surface-alt rounded-2xl border border-neutral-300 p-10 lg:p-16 text-center overflow-hidden shadow-soft"
      >
        <div
          class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-accent/10 rounded-full blur-[100px]"
        >
        </div>
        <div class="relative">
          <h2 class="text-3xl lg:text-4xl tracking-tight">
            <span class="font-display italic text-primary">Benieuwd of mijn aanpak</span>
            <span class="font-sans font-semibold text-primary-light">
              bij jouw bedrijf past?
            </span>
          </h2>
          <p class="font-sans text-neutral-500 mt-6 max-w-2xl mx-auto leading-relaxed text-lg">
            Plan een vrijblijvende kennismaking. Een gesprek van een half uur waarin we doornemen
            waar je staat en wat er voor jou te halen valt.
          </p>
          <div class="mt-8">
            <Button href={url('/contact/')} variant="primary" size="lg">
              Plan een kennismaking
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
