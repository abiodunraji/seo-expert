---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { url } from '../../lib/urls';

const collabModes = [
  {
    title: 'White label trajecten',
    description:
      'Volledige uitvoering van local SEO onder jullie merk. Jullie houden de klantrelatie, ik doe het werk. Rapportages, communicatie en oplevering worden afgestemd op jullie huisstijl en proces. Vast tarief per klant per maand, met marge voor jullie kant.',
  },
  {
    title: 'Losse opdrachten',
    description:
      'Audits, GBP-optimalisaties, set-up van nieuwe locaties, of het oplossen van specifieke problemen. Vast tarief per opdracht, korte doorlooptijden.',
  },
  {
    title: 'Strategische sparring',
    description:
      'Voor bureaus die zelf local SEO doen maar willen meedenken op specifieke vraagstukken, zoals een complexe multi-vestigingsklant, GEO-strategie voor lokale dienstverleners, of een ingewikkelde Google Business Profile situatie. Per uur, op afroep.',
  },
];

const benefits = [
  {
    title: 'Diepte in local en GEO',
    description:
      'Local SEO is mijn specialisatie, niet een van mijn zeven diensten. Ik heb webinars en trainingen over local SEO en GEO verzorgd voor andere bureaus, en zit voor op de combinatie van klassieke local en optimalisatie voor AI-zoekmachines.',
  },
  {
    title: 'Discretie en respect voor jullie relatie',
    description:
      'Geen direct contact met jullie klanten, tenzij jullie dat anders inrichten. Geen afleidende boodschappen, geen pogingen om de klant over te nemen. De klantrelatie is en blijft van jullie.',
  },
  {
    title: 'Voorspelbare uitvoering',
    description:
      'Vaste tarieven, afgesproken doorlooptijden, en duidelijke deliverables. Geen verrassingen op de factuur, geen scope-discussies achteraf.',
  },
  {
    title: 'Korte lijnen',
    description: 'Direct contact met mij. Geen accountmanagers, geen tussenlagen.',
  },
];
---

<BaseLayout
  title="Voor bureaus"
  description="Local SEO als white label of onderaannemer. Voor agencies en freelancers die local SEO willen aanbieden zonder zelf een specialist in huis te nemen."
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-20 lg:py-28 bg-surface-alt dot-grid">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[600px] bg-accent/5 rounded-full blur-[120px]"
    >
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="section-label">Voor bureaus en freelancers</span>
        <h1
          class="font-semibold text-4xl lg:text-5xl xl:text-6xl mt-5 tracking-tight leading-[1.1]"
        >
          <span class="font-display italic text-primary block">Local SEO als</span>
          <span class="font-sans text-primary-light block">white label of onderaannemer</span>
        </h1>
        <p class="font-sans text-lg lg:text-xl text-neutral-500 mt-6 leading-relaxed">
          Voor agencies en freelancers die local SEO willen aanbieden zonder zelf de
          specialistische kennis op te bouwen.
        </p>
        <div class="mt-8">
          <Button href={url('/contact/')} variant="primary" size="lg">Neem contact op</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- De situatie -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">De situatie</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Local SEO past niet in elk bureau,</span>
          <span class="font-sans font-semibold text-primary-light"> maar de vraag is er wel.</span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Veel bureaus krijgen vragen van klanten over lokale zichtbaarheid, het Google
            Bedrijfsprofiel, of reviews. Maar local SEO heeft een andere logica dan traditionele
            SEO voor webshops of contentsites, en vraagt om kennis die niet in elk team aanwezig
            is. Tegelijk is het commercieel zonde om die vraag door te verwijzen, zeker bij
            bestaande klanten met wie je al een goede relatie hebt.
          </p>
          <p>
            Voor die situatie ben ik er. Ik werk als onderaannemer voor bureaus en freelancers die
            local SEO als dienst willen aanbieden, maar zelf liever niet investeren in het
            opbouwen van die specialisatie.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Vormen van samenwerking -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl mb-16">
        <span class="section-label">Hoe het werkt</span>
        <h2 class="text-3xl lg:text-4xl mt-5 tracking-tight">
          <span class="font-display italic text-primary">Drie manieren</span>
          <span class="font-sans font-semibold text-primary-light"> om samen te werken.</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          collabModes.map((mode) => (
            <div class="card card-signal bg-surface">
              <h3 class="font-sans font-semibold text-xl text-primary mb-4">{mode.title}</h3>
              <p class="font-sans text-neutral-500 leading-relaxed">{mode.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Wat jullie krijgen -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl mb-16">
        <span class="section-label">Wat jullie krijgen</span>
        <h2 class="text-3xl lg:text-4xl mt-5 tracking-tight">
          <span class="font-display italic text-primary">Specialistische kennis</span>
          <span class="font-sans font-semibold text-primary-light">
            zonder dat je een specialist hoeft aan te nemen.
          </span>
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          benefits.map((b) => (
            <div class="card card-signal">
              <h3 class="font-sans font-semibold text-xl text-primary mb-3">{b.title}</h3>
              <p class="font-sans text-neutral-500 leading-relaxed">{b.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Tarieven -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Tarieven</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Vaste tarieven,</span>
          <span class="font-sans font-semibold text-primary-light"> transparant per type werk.</span>
        </h2>
        <p class="font-sans text-neutral-500 leading-relaxed text-lg">
          Voor white label trajecten en losse opdrachten werk ik met vaste tarieven per klant of
          per project, afhankelijk van de omvang. Voor strategische sparring per uur. In een eerste
          gesprek bespreken we welke vorm past, wat het volume is, en wat de tarieven concreet
          betekenen voor jullie marge.
        </p>
      </div>
    </div>
  </section>

  <!-- Slot CTA -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div
        class="relative bg-surface-alt rounded-2xl border border-neutral-300 p-10 lg:p-16 text-center overflow-hidden shadow-soft"
      >
        <div
          class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-accent/10 rounded-full blur-[100px]"
        >
        </div>
        <div class="relative">
          <h2 class="text-3xl lg:text-4xl tracking-tight">
            <span class="font-display italic text-primary">Interesse in een</span>
            <span class="font-sans font-semibold text-primary-light"> verkennend gesprek?</span>
          </h2>
          <p class="font-sans text-neutral-500 mt-6 max-w-2xl mx-auto leading-relaxed text-lg">
            Een eerste gesprek kost een half uur. Geen verkooppraatje, wel een eerlijke verkenning
            van hoe een samenwerking eruit zou kunnen zien.
          </p>
          <div class="mt-8">
            <Button href={url('/contact/')} variant="primary" size="lg">Neem contact op</Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
