---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { url } from '../../lib/urls';

const collabModes = [
  {
    title: 'White label trajecten',
    description:
      'Volledige uitvoering van SEO of GEO onder jullie merk. Jullie houden de klantrelatie, ik doe het werk. Rapportages, communicatie en oplevering worden afgestemd op jullie huisstijl en proces.',
  },
  {
    title: 'Losse opdrachten',
    description:
      'Technische audits, contentstrategie, GEO-trajecten, of het oplossen van een specifiek vraagstuk. Vaste afspraken, duidelijke deliverables, korte doorlooptijden.',
  },
  {
    title: 'Interim capaciteit',
    description:
      'Meedraaien in een lopend klantteam of jullie eigen team wanneer de capaciteit of de specialistische kennis tijdelijk ontbreekt. Remote of op locatie, voor een afgebakende periode.',
  },
];

const benefits = [
  {
    title: 'Diepte in SEO en GEO',
    description:
      'Een brede SEO-specialist met GEO als scherpste punt. Ik heb honderden professionals getraind en webinars over GEO verzorgd voor externe bureaus, met een nuchtere, op bewijs gebaseerde aanpak in plaats van hype.',
  },
  {
    title: 'Discretie en respect voor jullie relatie',
    description:
      'Geen direct contact met jullie klanten, tenzij jullie dat anders inrichten. Geen afleidende boodschappen, geen pogingen om de klant over te nemen. De klantrelatie is en blijft van jullie.',
  },
  {
    title: 'Voorspelbare uitvoering',
    description:
      'Duidelijke afspraken, afgesproken doorlooptijden en heldere deliverables. Geen verrassingen op de factuur, geen scope-discussies achteraf.',
  },
  {
    title: 'Korte lijnen',
    description:
      'Direct contact met de specialist die het werk doet. Geen accountmanagers, geen tussenlagen.',
  },
];
---

<BaseLayout
  title="Voor bureaus"
  description="Tijdelijke SEO- en GEO-capaciteit onder jullie eigen merk. Als interim, onderaannemer of op projectbasis, voor bureaus die een brede specialist nodig hebben."
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-20 lg:py-28 bg-surface-alt dot-grid">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[600px] bg-accent/5 rounded-full blur-[120px]"
    >
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="section-label">Voor bureaus</span>
        <h1
          class="font-semibold text-4xl lg:text-5xl xl:text-6xl mt-5 tracking-tight leading-[1.1]"
        >
          <span class="font-display italic text-primary block">SEO- en GEO-capaciteit</span>
          <span class="font-sans text-primary-light block">onder jullie eigen merk</span>
        </h1>
        <p class="font-sans text-lg lg:text-xl text-neutral-500 mt-6 leading-relaxed">
          Voor bureaus die tijdelijk een brede SEO-specialist of GEO-expertise nodig hebben. Als
          interim, als onderaannemer, of op projectbasis.
        </p>
        <div class="mt-8">
          <Button href={url('/contact/')} variant="primary" size="lg">Neem contact op</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- De situatie -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">De situatie</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Soms is de vraag er wel,</span>
          <span class="font-sans font-semibold text-primary-light"> maar de capaciteit even niet.</span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Een klant vraagt om SEO of om zichtbaarheid in AI-zoekmachines, een specialist valt weg,
            of een project vraagt tijdelijk om meer handen dan het team heeft. Dat zijn de momenten
            waarop het commercieel zonde is om nee te verkopen, en waarop je liever niet meteen
            iemand aanneemt voor iets wat tijdelijk is.
          </p>
          <p>
            Voor die situatie ben ik er. Ik stap in als interim of onderaannemer, lever strategie en
            uitvoering over de volle breedte van SEO en GEO, en draag het werk zo over dat jullie
            team er zelf mee verder kan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Vormen van samenwerking -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl mb-16">
        <span class="section-label">Hoe het werkt</span>
        <h2 class="text-3xl lg:text-4xl mt-5 tracking-tight">
          <span class="font-display italic text-primary">Drie manieren</span>
          <span class="font-sans font-semibold text-primary-light"> om samen te werken.</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          collabModes.map((mode) => (
            <div class="card card-signal bg-surface">
              <h3 class="font-sans font-semibold text-xl text-primary mb-4">{mode.title}</h3>
              <p class="font-sans text-neutral-500 leading-relaxed">{mode.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Wat jullie krijgen -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl mb-16">
        <span class="section-label">Wat jullie krijgen</span>
        <h2 class="text-3xl lg:text-4xl mt-5 tracking-tight">
          <span class="font-display italic text-primary">Specialistische kennis</span>
          <span class="font-sans font-semibold text-primary-light">
            zonder dat je iemand hoeft aan te nemen.
          </span>
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          benefits.map((b) => (
            <div class="card card-signal">
              <h3 class="font-sans font-semibold text-xl text-primary mb-3">{b.title}</h3>
              <p class="font-sans text-neutral-500 leading-relaxed">{b.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Tarieven -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Afspraken</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Heldere afspraken,</span>
          <span class="font-sans font-semibold text-primary-light"> per type samenwerking.</span>
        </h2>
        <p class="font-sans text-neutral-500 leading-relaxed text-lg">
          Voor interim-trajecten werk ik met een dag- of uurtarief, voor losse opdrachten en white
          label trajecten met vaste afspraken per project. In een eerste gesprek bespreken we welke
          vorm past, wat het volume is, en wat de afspraken concreet betekenen voor jullie kant.
        </p>
      </div>
    </div>
  </section>

  <!-- Slot CTA -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div
        class="relative bg-surface-alt rounded-2xl border border-neutral-300 p-10 lg:p-16 text-center overflow-hidden shadow-soft"
      >
        <div
          class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-accent/10 rounded-full blur-[100px]"
        >
        </div>
        <div class="relative">
          <h2 class="text-3xl lg:text-4xl tracking-tight">
            <span class="font-display italic text-primary">Interesse in een</span>
            <span class="font-sans font-semibold text-primary-light"> verkennend gesprek?</span>
          </h2>
          <p class="font-sans text-neutral-500 mt-6 max-w-2xl mx-auto leading-relaxed text-lg">
            Een eerste gesprek kost een half uur. Geen verkooppraatje, wel een eerlijke verkenning
            van hoe een samenwerking eruit zou kunnen zien.
          </p>
          <div class="mt-8">
            <Button href={url('/contact/')} variant="primary" size="lg">Neem contact op</Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
