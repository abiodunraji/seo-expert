---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { url } from '../../lib/urls';

const components = [
  {
    title: 'Techniek en indexatie',
    description:
      "De technische staat van je site: crawlbaarheid, indexatie, structuur, snelheid, schema markup en de signalen die je pagina's uitzenden. De fundering waar de rest op rust.",
  },
  {
    title: 'Content en on-page',
    description:
      'Sluit je content aan op de zoekintentie van je publiek? Waar laat je posities liggen, waar is kannibalisatie, en welke pagina\'s verdienen de meeste aandacht. Mijn sterkste discipline.',
  },
  {
    title: 'GEO en AI-zichtbaarheid',
    description:
      'In hoeverre word je opgepikt door AI-zoekmachines als ChatGPT, Perplexity en Google AI Overviews. Niet alleen gestructureerde data, maar ook de corroboratie buiten je eigen site die bepaalt of je geciteerd wordt.',
  },
  {
    title: 'Autoriteit en verwijzingen',
    description:
      'Je linkprofiel, merkvermeldingen op het bredere web en earned media. De signalen buiten je eigen domein die zwaar wegen in zowel klassieke ranking als AI-aanbevelingen.',
  },
  {
    title: 'Local, waar relevant',
    description:
      'Voor opdrachtgevers met een lokale component: het Google Bedrijfsprofiel, reviews en de consistentie van lokale vermeldingen. Meegenomen waar het zichtbaarheid oplevert.',
  },
];
---

<BaseLayout
  title="SEO-audit"
  description="Een doorlichting van je SEO en GEO, met concrete bevindingen en een prioriteitenlijst. Techniek, content, autoriteit en zichtbaarheid in klassieke en AI-zoekresultaten."
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-20 lg:py-28 bg-surface-alt dot-grid">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[600px] bg-accent/5 rounded-full blur-[120px]"
    >
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="section-label">Dienst</span>
        <h1
          class="font-semibold text-4xl lg:text-5xl xl:text-6xl mt-5 tracking-tight leading-[1.1]"
        >
          <span class="font-display italic text-primary">SEO-audit</span>
        </h1>
        <p class="font-sans text-lg lg:text-xl text-neutral-500 mt-6 leading-relaxed">
          Een doorlichting van je SEO en GEO, met een concrete prioriteitenlijst. Techniek, content,
          autoriteit en je zichtbaarheid in klassieke en AI-zoekresultaten.
        </p>
        <div class="mt-8">
          <Button href={url('/contact/')} variant="primary" size="lg">Vraag een audit aan</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Wat je krijgt -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Wat je krijgt</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Helder beeld van waar je staat</span>
          <span class="font-sans font-semibold text-primary-light"> en wat er te halen valt.</span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Een SEO-audit beantwoordt drie vragen. Hoe sta je er nu voor in de klassieke
            zoekresultaten en in AI-zoekmachines? Wat gaat goed en wat zit je in de weg? Welke
            ingrepen leveren de meeste impact op, en in welke volgorde pak je ze aan?
          </p>
          <p>
            Het resultaat is een rapport met concrete bevindingen, een prioriteitenlijst, en een
            gesprek waarin we de uitkomsten samen doornemen. Geen tweehonderd actiepunten waar
            niemand mee aan de slag gaat, wel de acties die echt verschil maken, in de juiste
            volgorde. Een document dat je intern of met je team kunt delen en direct kunt uitvoeren.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Wat de audit omvat -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl mb-16">
        <span class="section-label">Wat de audit omvat</span>
        <h2 class="text-3xl lg:text-4xl mt-5 tracking-tight">
          <span class="font-display italic text-primary">Vijf onderdelen,</span>
          <span class="font-sans font-semibold text-primary-light"> op elkaar afgestemd.</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          components.map((item) => (
            <div class="card card-signal">
              <h3 class="font-sans font-semibold text-xl text-primary mb-3">{item.title}</h3>
              <p class="font-sans text-neutral-500 leading-relaxed">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Werkwijze -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Werkwijze</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Van aanvraag tot rapport</span>
          <span class="font-sans font-semibold text-primary-light"> in twee weken.</span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Na aanvraag volgt een korte intake, waarin we doornemen welke informatie ik nodig heb
            (toegang tot Google Search Console, Analytics en, waar relevant, het Google
            Bedrijfsprofiel) en waar de audit de nadruk op moet leggen. Daarna ga ik aan de slag.
          </p>
          <p>
            Binnen twee weken ontvang je het rapport, gevolgd door een gesprek van een half uur
            waarin we de uitkomsten en de prioriteiten doornemen. Je krijgt het rapport mee als
            document dat je intern of met je bureau kunt delen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tarief -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Tarief</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Vaste prijs,</span>
          <span class="font-sans font-semibold text-primary-light"> afgestemd op de scope.</span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            De audit heeft een vaste prijs, afgestemd op de omvang en de nadruk die je nodig hebt.
            Voor grotere sites of een bredere scope geldt een aangepast tarief, dat we in de intake
            vaststellen zodat je vooraf weet waar je aan toe bent.
          </p>
          <p>
            Kies je na de audit voor uitvoering, als interim of op projectbasis, dan wordt de audit
            verrekend met de vervolgopdracht.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Slot CTA -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div
        class="relative bg-surface-alt rounded-2xl border border-neutral-300 p-10 lg:p-16 text-center overflow-hidden shadow-soft"
      >
        <div
          class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-accent/10 rounded-full blur-[100px]"
        >
        </div>
        <div class="relative">
          <h2 class="text-3xl lg:text-4xl tracking-tight">
            <span class="font-display italic text-primary">Klaar om te weten</span>
            <span class="font-sans font-semibold text-primary-light"> waar je staat?</span>
          </h2>
          <p class="font-sans text-neutral-500 mt-6 max-w-2xl mx-auto leading-relaxed text-lg">
            Vul het contactformulier in of plan direct een korte intake. Ik laat je binnen één
            werkdag weten wat de volgende stap is.
          </p>
          <div class="mt-8">
            <Button href={url('/contact/')} variant="primary" size="lg">Vraag een audit aan</Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
