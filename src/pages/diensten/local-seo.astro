---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { url } from '../../lib/urls';

const pillars = [
  {
    title: 'Google Bedrijfsprofiel',
    description:
      "De belangrijkste plek waar lokale vindbaarheid wordt bepaald. Volledigheid, juiste categorieën, beschrijving, foto's, openingstijden, productlijst, antwoordtijd op vragen. Een goed onderhouden profiel werkt zowel in Google als in AI-zoekmachines, want zij gebruiken dezelfde bron.",
  },
  {
    title: 'Reviews en reputatie',
    description:
      'Reviews wegen zwaar in zowel de keuze van de klant als de positie in de zoekresultaten. Een structurele aanpak om reviews binnen te krijgen, met de juiste reacties, en het herstellen van eventuele oneerlijke beoordelingen.',
  },
  {
    title: 'Lokale signalen en vermeldingen',
    description:
      'Naam, adres en telefoonnummer moeten overal consistent staan. In branchegidsen, op kaartdiensten, op portals die relevant zijn voor de sector. Inconsistentie kost zichtbaarheid.',
  },
  {
    title: 'Website en techniek',
    description:
      "De website ondersteunt het bedrijfsprofiel. De pagina's die het meest bijdragen aan lokale vindbaarheid, de technische basis, schema markup, en de lokale signalen die de site uitzendt. Geen tweehonderd actiepunten, wel wat in deze context echt verschil maakt.",
  },
];
---

<BaseLayout
  title="Local SEO"
  description="Local SEO als competentie binnen mijn brede SEO-werk. Google Bedrijfsprofiel, reviews, lokale signalen en de techniek eromheen, onderbouwd met ruim honderd beheerde bedrijfsprofielen."
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-20 lg:py-28 bg-surface-alt dot-grid">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[600px] bg-accent/5 rounded-full blur-[120px]"
    >
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="section-label">Competentie</span>
        <h1
          class="font-semibold text-4xl lg:text-5xl xl:text-6xl mt-5 tracking-tight leading-[1.1]"
        >
          <span class="font-display italic text-primary">Local SEO</span>
        </h1>
        <p class="font-sans text-lg lg:text-xl text-neutral-500 mt-6 leading-relaxed">
          Een van de dingen die ik goed kan, niet waar ik voor sta. Onderdeel van mijn brede
          SEO-werk, met ruime operationele schaal: meer dan honderd beheerde bedrijfsprofielen.
        </p>
        <div class="mt-8">
          <Button href={url('/contact/')} variant="primary" size="lg">
            Plan een gesprek
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Wat is local SEO -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Wat is local SEO</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Vindbaar worden</span>
          <span class="font-sans font-semibold text-primary-light"> waar lokaal gezocht wordt.</span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Local SEO richt zich op de zichtbaarheid van bedrijven in lokale zoekresultaten. In de
            praktijk gaat het om drie plekken waar mensen beslissen: de lokale resultaten in Google
            (de kaart met drie bedrijven die bovenin verschijnt), Google Maps zelf, en steeds vaker
            de antwoorden van AI-zoekmachines zoals ChatGPT en Google AI Overviews.
          </p>
          <p>
            Het is een vakgebied met een eigen logica, die anders werkt dan SEO voor een webshop of
            een landelijke dienst. Het is een van de disciplines die ik beheers, en die ik inzet waar
            een opdrachtgever of klant een lokale component heeft. Onderdeel van een breder
            SEO-traject, niet het hoofdverhaal.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- De vier pijlers -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl mb-16">
        <span class="section-label">Waar het werk uit bestaat</span>
        <h2 class="text-3xl lg:text-4xl mt-5 tracking-tight">
          <span class="font-display italic text-primary">De vier pijlers</span>
          <span class="font-sans font-semibold text-primary-light"> van local SEO.</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          pillars.map((pillar) => (
            <div class="card card-signal">
              <h3 class="font-sans font-semibold text-xl text-primary mb-4">{pillar.title}</h3>
              <p class="font-sans text-neutral-500 leading-relaxed">{pillar.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- AI search -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Local SEO en AI-zoekmachines</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Voor lokale aanbevelingen kijken</span>
          <span class="font-sans font-semibold text-primary-light">
            AI-systemen naar je bedrijfsprofiel.
          </span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Wanneer iemand aan ChatGPT, Google AI Overviews of Perplexity vraagt om een lokale
            aanbeveling, putten die systemen voor een groot deel uit je Google Bedrijfsprofiel. Wat
            daar staat over je dienst, je openingstijden, je reviews en je categorieën, is wat een
            AI-assistent oppikt en doorgeeft.
          </p>
          <p>
            Voor lokale aanbevelingen vallen local SEO en AI-zichtbaarheid daarom grotendeels samen. Een goed
            onderhouden bedrijfsprofiel werkt zowel in de klassieke zoekresultaten als in de
            AI-antwoorden die daar steeds vaker bovenop verschijnen. In een lokaal traject is de
            voorbereiding op AI-zoekmachines standaard onderdeel van het werk.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hoe ik het inzet -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Hoe ik het inzet</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Als audit, als uitvoering,</span>
          <span class="font-sans font-semibold text-primary-light"> of binnen je team.</span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Ik zet local SEO in als onderdeel van een bredere opdracht of als afgebakend stuk werk.
            Als doorlichting van de huidige lokale zichtbaarheid, als uitvoering van de optimalisaties
            die het meeste opleveren, of als capaciteit binnen een bureau of in-house team dat een
            klant met een lokale component bedient.
          </p>
          <p>
            Als interim, als onderaannemer of op projectbasis, remote of op locatie. In een eerste
            gesprek bespreken we wat er nodig is en welke vorm past.
          </p>
        </div>
        <div class="mt-8">
          <a
            href={url('/diensten/local-seo-audit/')}
            class="inline-flex items-center gap-2 font-sans text-primary-light hover:text-primary transition-colors duration-300"
          >
            Bekijk de SEO-audit
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Slot CTA -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div
        class="relative bg-surface-alt rounded-2xl border border-neutral-300 p-10 lg:p-16 text-center overflow-hidden shadow-soft"
      >
        <div
          class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-accent/10 rounded-full blur-[100px]"
        >
        </div>
        <div class="relative">
          <h2 class="text-3xl lg:text-4xl tracking-tight">
            <span class="font-display italic text-primary">Een opdracht met</span>
            <span class="font-sans font-semibold text-primary-light">
              een lokale component?
            </span>
          </h2>
          <p class="font-sans text-neutral-500 mt-6 max-w-2xl mx-auto leading-relaxed text-lg">
            Plan een gesprek van een half uur. We nemen door wat er speelt en hoe ik zou instappen.
          </p>
          <div class="mt-8">
            <Button href={url('/contact/')} variant="primary" size="lg">
              Plan een gesprek
            </Button>
          </div>
          <p class="font-mono text-xs text-neutral-500 uppercase tracking-widest mt-6">
            Beschikbaar voor interim en freelance. Remote of op locatie.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
