---
import Base from '../layouts/Base.astro';
import PageTop from '../components/PageTop.astro';
---
<Base title="Pagina niet gevonden | Iwan Stepanova" description="Deze pagina bestaat niet." path="/404">
  <PageTop label="404" />
  <main class="pg">
    <h1>Geen resultaat voor deze <span class="grad-txt">zoekopdracht</span>.</h1>
    <p class="lead">Deze pagina bestaat niet of is verplaatst. Terug naar de resultaten?</p>
    <div class="cta-row"><a class="cta-btn" href="/">Naar de homepage</a></div>
  </main>
</Base>
