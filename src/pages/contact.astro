---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Contact"
  description="Beschikbaar voor interim- en freelanceopdrachten in SEO en GEO. Plan een gesprek met Iwan Stepanova, remote of op locatie, voor heel Nederland."
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-20 lg:py-24 bg-surface-alt dot-grid">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[600px] bg-accent/5 rounded-full blur-[120px]"
    >
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="section-label">Contact</span>
        <h1
          class="font-semibold text-4xl lg:text-5xl xl:text-6xl mt-5 tracking-tight leading-[1.1]"
        >
          <span class="font-display italic text-primary block">Plan een</span>
          <span class="font-sans text-primary-light block">gesprek</span>
        </h1>
        <p class="font-sans text-lg lg:text-xl text-neutral-500 mt-6 leading-relaxed">
          Beschikbaar voor interim- en freelanceopdrachten in SEO en GEO. Een gesprek van een half
          uur waarin we doornemen wat je nodig hebt en hoe ik zou instappen. Geen verkooppraatje.
        </p>
      </div>
    </div>
  </section>

  <!-- Form + direct contact -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">
        <!-- Form -->
        <div class="lg:col-span-3">
          <div class="bg-surface-alt rounded-xl border border-neutral-300 p-6 lg:p-10 shadow-soft">
            <ContactForm />
          </div>
        </div>

        <!-- Direct contact + werkgebied -->
        <div class="lg:col-span-2 space-y-12">
          <div>
            <span class="section-label">Liever direct contact</span>
            <div class="mt-6 space-y-5">
              <div class="group flex items-start gap-4">
                <div
                  class="flex-shrink-0 w-11 h-11 bg-surface rounded-lg border border-neutral-300 flex items-center justify-center transition-all duration-300 group-hover:border-accent/50 group-hover:bg-accent/5"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 text-primary-light"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <p class="font-mono text-xs text-neutral-500 uppercase tracking-[0.15em]">Email</p>
                  <a
                    href="mailto:hallo@iwanstepanova.com"
                    class="font-sans text-primary hover:text-primary-light transition-colors duration-300"
                  >
                    hallo@iwanstepanova.com
                  </a>
                </div>
              </div>

              <div class="group flex items-start gap-4">
                <div
                  class="flex-shrink-0 w-11 h-11 bg-surface rounded-lg border border-neutral-300 flex items-center justify-center transition-all duration-300 group-hover:border-accent/50 group-hover:bg-accent/5"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 text-primary-light"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <p class="font-mono text-xs text-neutral-500 uppercase tracking-[0.15em]">
                    Telefoon
                  </p>
                  <a
                    href="tel:+31623872013"
                    class="font-sans text-primary hover:text-primary-light transition-colors duration-300"
                  >
                    06 238 72013
                  </a>
                </div>
              </div>

              <div class="group flex items-start gap-4">
                <div
                  class="flex-shrink-0 w-11 h-11 bg-surface rounded-lg border border-neutral-300 flex items-center justify-center transition-all duration-300 group-hover:border-accent/50 group-hover:bg-accent/5"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 text-primary-light"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"
                    ></path>
                    <circle cx="4" cy="4" r="2"></circle>
                  </svg>
                </div>
                <div>
                  <p class="font-mono text-xs text-neutral-500 uppercase tracking-[0.15em]">
                    LinkedIn
                  </p>
                  <a
                    href="https://www.linkedin.com/in/iwan-stepanova-seo/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-sans text-primary hover:text-primary-light transition-colors duration-300"
                  >
                    iwan-stepanova-seo
                  </a>
                </div>
              </div>
            </div>
          </div>

          <div>
            <span class="section-label">Beschikbaarheid en werkgebied</span>
            <p class="font-sans text-neutral-500 mt-6 leading-relaxed">
              Beschikbaar voor interim- en freelanceopdrachten in SEO en GEO, zowel langere
              interim-trajecten als projectwerk. Ik werk vanuit de omgeving Alkmaar voor
              opdrachtgevers door heel Nederland, remote of op locatie.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
