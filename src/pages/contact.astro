---
import Base from '../layouts/Base.astro';
import PageTop from '../components/PageTop.astro';
const title = 'Contact, plan een gesprek | Iwan Stepanova';
const description = 'Plan een gesprek van een half uur of vraag een vrijblijvende analyse aan. Een scherpe inschatting van je SEO-kansen, zonder verkooppraatje.';
---
<Base title={title} description={description} path="/contact" breadcrumb="Contact">
  <PageTop label="Contact" />
  <main class="pg">
    <div class="u">https://iwanstepanova.com &rsaquo; contact</div>
    <h1>Even sparren over je <span class="grad-txt">SEO-kansen</span>?</h1>
    <p class="lead">Plan een gesprek van een half uur, of vraag een vrijblijvende analyse aan. Je krijgt een scherpe inschatting van waar je kansen liggen en hoe ik zou instappen. Geen verkooppraatje.</p>
    <div class="hr"></div>
    <div class="cta-row"><a class="cta-btn" href="https://calendar.app.google/E8RDQakjnYcmxbYx6" target="_blank" rel="noopener">Plan een gesprek</a></div>
    <div class="divider">of stuur een bericht</div>
    <form class="cform" action="https://formspree.io/f/mnjywjew" method="POST">
      <!-- Formspree honeypot: bots fill this, humans never see it -->
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;opacity:0;height:0;width:0;" aria-hidden="true" />
      <input type="hidden" name="_subject" value="Nieuw bericht via iwanstepanova.com" />
      <h2>Vraag een vrijblijvende analyse aan</h2>
      <div class="frow">
        <div><label for="naam">Naam</label><input id="naam" name="naam" required /></div>
        <div><label for="email">E-mail</label><input id="email" type="email" name="email" required /></div>
      </div>
      <div class="full"><label for="bedrijf">Bedrijf</label><input id="bedrijf" name="bedrijf" /></div>
      <div class="full"><label for="bericht">Waar loop je tegenaan?</label><textarea id="bericht" name="bericht" required></textarea></div>
      <button type="submit">Verstuur</button>
    </form>
    <p class="mailrow">Liever direct mailen? Dat kan via <a href="mailto:hallo@iwanstepanova.com">hallo@iwanstepanova.com</a>.</p>
  </main>
</Base>
