---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { url } from '../lib/urls';

const clientLogos = [
  { name: 'ANWB', src: url('/images/clients/anwb.png') },
  { name: 'Interpolis', src: url('/images/clients/interpolis.png') },
  { name: 'Action', src: url('/images/clients/action.png') },
  { name: 'Etos', src: url('/images/clients/etos.png') },
];
---

<BaseLayout
  title="Iwan Stepanova, Local SEO specialist voor MKB en dienstverleners"
  description="Lokaal vindbaar worden, zonder fluff. Local SEO voor dienstverleners en MKB-bedrijven die hun klanten uit de eigen regio halen."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-20 lg:py-32 bg-surface-alt dot-grid">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-accent/5 rounded-full blur-[120px]"
    >
    </div>

    <!-- Constellation SVG motif (top-right, desktop only) -->
    <svg
      class="hidden lg:block absolute top-12 right-16 pointer-events-none select-none"
      width="340"
      height="260"
      viewBox="0 0 340 260"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <line x1="170" y1="130" x2="60" y2="48" stroke="#C8A882" stroke-width="0.75" opacity="0.45" class="constellation-line" style="animation-delay: 0s"></line>
      <line x1="170" y1="130" x2="280" y2="62" stroke="#C8A882" stroke-width="0.75" opacity="0.45" class="constellation-line" style="animation-delay: 0.1s"></line>
      <line x1="170" y1="130" x2="305" y2="185" stroke="#C8A882" stroke-width="0.75" opacity="0.45" class="constellation-line" style="animation-delay: 0.2s"></line>
      <line x1="170" y1="130" x2="120" y2="220" stroke="#C8A882" stroke-width="0.75" opacity="0.45" class="constellation-line" style="animation-delay: 0.3s"></line>
      <line x1="170" y1="130" x2="42" y2="165" stroke="#C8A882" stroke-width="0.75" opacity="0.45" class="constellation-line" style="animation-delay: 0.4s"></line>
      <circle cx="170" cy="130" r="4.5" fill="#C8A882" opacity="0.65" class="constellation-node" style="--node-opacity: 0.65; animation-delay: 0.15s"></circle>
      <circle cx="60" cy="48" r="2.8" fill="#C8A882" opacity="0.50" class="constellation-node" style="--node-opacity: 0.50; animation-delay: 0.5s"></circle>
      <circle cx="280" cy="62" r="2.8" fill="#C8A882" opacity="0.50" class="constellation-node" style="--node-opacity: 0.50; animation-delay: 0.55s"></circle>
      <circle cx="305" cy="185" r="2.8" fill="#C8A882" opacity="0.50" class="constellation-node" style="--node-opacity: 0.50; animation-delay: 0.6s"></circle>
      <circle cx="120" cy="220" r="2.8" fill="#C8A882" opacity="0.50" class="constellation-node" style="--node-opacity: 0.50; animation-delay: 0.65s"></circle>
      <circle cx="42" cy="165" r="2.8" fill="#C8A882" opacity="0.50" class="constellation-node" style="--node-opacity: 0.50; animation-delay: 0.7s"></circle>
    </svg>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Text Content -->
        <div class="space-y-6 lg:space-y-8">
          <span class="section-label">Local SEO specialist</span>

          <h1
            class="font-semibold text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-[1.1] tracking-tight"
          >
            <span class="block font-display italic text-primary">Lokaal vindbaar</span>
            <span class="block font-sans text-primary-light">worden, zonder fluff</span>
          </h1>

          <p class="font-sans text-lg lg:text-xl text-neutral-500 max-w-xl leading-relaxed">
            Voor dienstverleners en MKB-bedrijven die hun klanten uit de eigen regio halen. Een
            aanpak die zich richt op wat lokaal het meest oplevert.
          </p>

          <div class="flex flex-wrap gap-4 items-center">
            <Button href={url('/contact/')} variant="primary" size="lg">
              Plan een kennismaking
            </Button>
            <Button href={url('/diensten/local-seo/')} variant="outline" size="lg">
              Hoe werkt het
            </Button>
          </div>

          <p class="font-mono text-xs text-neutral-500 uppercase tracking-widest">
            Maandelijks opzegbaar. Geen opstartkosten.
          </p>
        </div>

        <!-- Image -->
        <div class="relative">
          <div class="absolute inset-0 bg-accent/5 rounded-2xl blur-3xl"></div>
          <div
            class="relative bg-surface rounded-2xl border border-neutral-300 overflow-hidden shadow-soft"
          >
            <img src={url('/images/iwan.png')} alt="Iwan Stepanova" class="w-full h-auto" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logos -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="text-center mb-10">
        <span class="section-label">Vertrouwd door</span>
      </div>

      <div class="relative overflow-hidden">
        <div
          class="absolute left-0 top-0 bottom-0 w-20 bg-gradient-to-r from-surface to-transparent z-10"
        >
        </div>
        <div
          class="absolute right-0 top-0 bottom-0 w-20 bg-gradient-to-l from-surface to-transparent z-10"
        >
        </div>
        <div class="animate-marquee flex items-center gap-12">
          {
            [...clientLogos, ...clientLogos].map((client) => (
              <div class="flex-shrink-0 flex items-center justify-center px-6 py-4">
                <img
                  src={client.src}
                  alt={client.name}
                  class="max-h-12 w-auto object-contain"
                  loading="lazy"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Het probleem -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Herkenbaar?</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Je zit op de juiste plek,</span>
          <span class="font-sans font-semibold text-primary-light">
            maar de juiste klanten vinden je niet.
          </span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            De meeste Nederlandse bedrijven halen hun klanten uit de eigen regio. Een fysiotherapeut,
            een advocaat, een installateur, een restaurant. Voor die bedrijven is online
            vindbaarheid niet een van de marketingkanalen. Het is vaak het belangrijkste.
          </p>
          <p>
            En toch laat een meerderheid daar omzet liggen. Een Google Bedrijfsprofiel dat niet
            compleet is. Reviews die niet structureel binnenkomen. Een website die technisch klopt
            maar geen lokale signalen geeft. Stuk voor stuk dingen die individueel klein lijken,
            maar bij elkaar het verschil maken tussen gevonden worden of niet.
          </p>
          <p>
            Local SEO is een vakgebied op zich. Het vraagt om andere keuzes dan een traditionele
            SEO-aanpak voor een webshop of een landelijke dienst. Wie dat onderscheid maakt en in
            de juiste volgorde werkt, haalt er aanzienlijk meer uit.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Waarom local SEO -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl mb-16">
        <span class="section-label">Waarom local SEO</span>
        <h2 class="text-3xl lg:text-4xl mt-5 tracking-tight">
          <span class="font-display italic text-primary">Het kanaal dat het meest oplevert,</span>
          <span class="font-sans font-semibold text-primary-light">
            krijgt vaak de minste aandacht.
          </span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card card-signal">
          <h3 class="font-sans font-semibold text-xl text-primary mb-4">Daar zoeken je klanten</h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Mensen die op zoek zijn naar een lokale dienstverlener, beginnen vrijwel altijd in
            Google of in Google Maps. Een sterk Google Bedrijfsprofiel staat letterlijk bovenaan de
            zoekresultaten, voor de eerste websites uit. Geen ander kanaal geeft die positie.
          </p>
        </div>
        <div class="card card-signal">
          <h3 class="font-sans font-semibold text-xl text-primary mb-4">Daar wordt gekozen</h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Reviews, foto's, openingstijden, antwoordtijd op vragen. Voordat een klant je website
            opent, heeft hij vaak al een beslissing genomen op basis van wat hij in Google ziet.
            Wat daar staat, bepaalt of jij gebeld wordt of je concurrent.
          </p>
        </div>
        <div class="card card-signal">
          <h3 class="font-sans font-semibold text-xl text-primary mb-4">Daar zit het rendement</h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Voor de meeste lokale bedrijven is het Google Bedrijfsprofiel het hoogst renderende
            marketingkanaal. Geen advertentiekosten, geen wekelijkse contentproductie. Eén keer
            goed opzetten, blijvend onderhouden, en het werkt jaren door.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- AI search en GBP -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Local SEO en AI search</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">AI-zoekmachines kijken vooral</span>
          <span class="font-sans font-semibold text-primary-light">
            naar je Google Bedrijfsprofiel.
          </span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Wanneer iemand aan ChatGPT, Google AI Overviews of Perplexity vraagt om een lokale
            aanbeveling, putten die systemen voor een groot deel uit een bron: je Google
            Bedrijfsprofiel. Wat daar staat over je dienst, je openingstijden, je reviews en je
            categorieën, dat is wat een AI-assistent oppikt en doorgeeft aan de gebruiker die naar
            een lokale dienstverlener zoekt.
          </p>
          <p>
            Dat maakt local SEO en AI search in de praktijk niet twee aparte disciplines, maar
            een. Een goed onderhouden bedrijfsprofiel werkt zowel in de klassieke Google-resultaten
            als in de AI-antwoorden die daar steeds vaker bovenop verschijnen. Wie dat onderdeel
            goed op orde heeft, profiteert dubbel.
          </p>
          <p>
            Veel partijen behandelen GEO (Generative Engine Optimization, optimalisatie voor
            AI-zoekmachines) als een aparte hype. Voor lokale bedrijven is het dat niet. Het is
            gewoon onderdeel van local SEO goed doen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mijn aanpak -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Mijn aanpak</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">In de juiste volgorde werken,</span>
          <span class="font-sans font-semibold text-primary-light">
            beginnen waar de impact het grootst is.
          </span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Local SEO heeft een eigen hiërarchie. Wat het meeste oplevert komt eerst: een volledig
            en goed onderhouden Google Bedrijfsprofiel, een structurele aanpak voor reviews,
            consistente vermeldingen in de juiste lokale bronnen. Pas daarna komt de website aan
            bod, en alleen de optimalisaties die in deze context echt verschil maken.
          </p>
          <p>
            Geen tweehonderd "actiepunten" in een rapport waar niemand iets mee doet. Geen
            optimalisaties die voor een webshop relevant zijn maar voor een lokale dienstverlener
            niet. Wel een helder traject met heldere keuzes, een vast maandbedrag, en resultaten
            die zichtbaar zijn in Google.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Voor wie -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Voor wie</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Dienstverleners en MKB-bedrijven</span>
          <span class="font-sans font-semibold text-primary-light">
            met een lokale klantenkring.
          </span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Mijn werk richt zich op bedrijven die hun omzet uit de eigen regio halen. Praktijken in
            de zorg, advocaten en accountants, installateurs en bouwbedrijven, horeca en
            restaurants, kappers en schoonheidsspecialisten, kleinschalige retail met een fysieke
            locatie.
          </p>
          <p>
            Wat al deze sectoren delen, is dat hun klanten in Google zoeken op naam, plaats of
            dienst, vaak vanaf hun telefoon, vaak met de intentie om diezelfde week iets te plannen
            of te kopen. De afstand tussen zoeken en kiezen is kort. Dat maakt local SEO voor deze
            bedrijven aantoonbaar het meest renderende kanaal.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Werkwijze -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl mb-16">
        <span class="section-label">Hoe het werkt</span>
        <h2 class="text-3xl lg:text-4xl mt-5 tracking-tight">
          <span class="font-display italic text-primary">Drie stappen.</span>
          <span class="font-sans font-semibold text-primary-light"> Geen verrassingen.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
        <div>
          <span
            class="font-display italic text-7xl text-accent/30 leading-none block mb-4 select-none"
          >
            01
          </span>
          <h3 class="font-sans font-semibold text-xl text-primary mb-3">Kennismaking</h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Een vrijblijvend gesprek waarin we doornemen waar je staat, wat je doelen zijn en
            welke kansen er liggen. Geen verkooppraatje, wel een eerlijke inschatting van wat er
            mogelijk is.
          </p>
        </div>
        <div>
          <span
            class="font-display italic text-7xl text-accent/30 leading-none block mb-4 select-none"
          >
            02
          </span>
          <h3 class="font-sans font-semibold text-xl text-primary mb-3">Strategie en uitvoering</h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Ik werk de strategie uit en zet de eerste belangrijke optimalisaties direct in gang.
            Bedrijfsprofiel, reviews, lokale vermeldingen, technische basis. De fundering staat
            binnen de eerste maanden.
          </p>
        </div>
        <div>
          <span
            class="font-display italic text-7xl text-accent/30 leading-none block mb-4 select-none"
          >
            03
          </span>
          <h3 class="font-sans font-semibold text-xl text-primary mb-3">
            Doorlopende optimalisatie
          </h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Local SEO is geen project dat af is. Posities verschuiven, reviews komen binnen,
            concurrenten bewegen. Maandelijks zorg ik dat je voor blijft op wat er gebeurt, met
            heldere rapportages waaruit blijkt wat het oplevert.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tarief en samenwerking -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Werkwijze en tarief</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Langdurige samenwerking.</span>
          <span class="font-sans font-semibold text-primary-light">
            Vast tarief. Maandelijks opzegbaar.
          </span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Mijn werk leent zich het best voor langdurige trajecten. Local SEO is een
            lange-termijn-spel waarin de eerste maanden bouwen zijn en de rendementen daarna
            doorlopen. Vandaar een vaste prijs per maand, geen opstartkosten, geen jaarcontract.
            Wel maandelijks opzegbaar, want vertrouwen verdien je elke maand opnieuw.
          </p>
          <p>
            Het exacte tarief hangt af van de situatie. De omvang van de praktijk, het aantal
            locaties, de huidige staat van het bedrijfsprofiel en de concurrentie in jouw regio. In
            een eerste gesprek krijg je daar een duidelijk antwoord op.
          </p>
          <p>
            Voor wie wil starten met een eenmalige analyse: een local SEO audit is ook beschikbaar
            als losse opdracht.
          </p>
        </div>
        <div class="mt-10">
          <Button href={url('/contact/')} variant="primary" size="lg">
            Plan een kennismaking
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Achtergrond -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Over Iwan</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Specialist in local SEO en AI search,</span>
          <span class="font-sans font-semibold text-primary-light">
            na jaren agency-ervaring.
          </span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Mijn ervaring komt uit het bureauleven. Ik werkte bij meerdere toonaangevende
            Nederlandse SEO-bureaus, waaronder het grootste marketingbureau van de Benelux. Daar
            specialiseerde ik me in local SEO en GEO, en gaf ik trainingen en webinars over die
            onderwerpen voor andere bureaus en freelancers.
          </p>
          <p>
            De keuze om me als specialist op local te richten, is bewust. Voor lokale bedrijven is
            het simpelweg het kanaal met het hoogste rendement, terwijl het in de markt opvallend
            weinig diepgaande aandacht krijgt. Die mismatch los ik op door me er volledig op te
            richten.
          </p>
        </div>
        <div class="mt-8">
          <a
            href={url('/over/')}
            class="inline-flex items-center gap-2 font-sans text-primary-light hover:text-primary transition-colors duration-300"
          >
            Lees meer over mij
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Voor bureaus -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Voor bureaus en freelancers</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Local SEO als white label</span>
          <span class="font-sans font-semibold text-primary-light"> of onderaannemerschap.</span>
        </h2>
        <p class="font-sans text-neutral-500 leading-relaxed text-lg">
          Voor bureaus en collega-freelancers die zelf geen local SEO specialist in huis hebben,
          neem ik losse opdrachten of doorlopende samenwerkingen aan. Audits, GBP-optimalisaties,
          GEO-strategie, of het volledig uitvoeren van local SEO trajecten onder jullie eigen merk.
          Korte lijnen, vaste tarieven, en discretie waar nodig.
        </p>
        <div class="mt-8">
          <a
            href={url('/diensten/voor-bureaus/')}
            class="inline-flex items-center gap-2 font-sans text-primary-light hover:text-primary transition-colors duration-300"
          >
            Meer over samenwerken met bureaus
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Slot CTA -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div
        class="relative bg-surface-alt rounded-2xl border border-neutral-300 p-10 lg:p-16 text-center overflow-hidden shadow-soft"
      >
        <div
          class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-accent/10 rounded-full blur-[100px]"
        >
        </div>

        <div class="relative">
          <h2 class="text-3xl lg:text-4xl xl:text-5xl tracking-tight">
            <span class="font-display italic text-primary">Laten we kijken</span>
            <span class="font-sans font-semibold text-primary-light">
              wat er voor jouw bedrijf mogelijk is.
            </span>
          </h2>
          <p class="font-sans text-neutral-500 mt-6 max-w-2xl mx-auto leading-relaxed text-lg">
            Een eerste gesprek kost een half uur en levert je in elk geval een eerlijke inschatting
            op van waar je staat en wat er te halen is. Geen verplichting, geen verkooppraatje.
          </p>
          <div class="mt-8 flex justify-center">
