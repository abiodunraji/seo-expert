---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { url } from '../lib/urls';

const clientLogos = [
  { name: 'ANWB', src: url('/images/clients/anwb.png') },
  { name: 'Interpolis', src: url('/images/clients/interpolis.png') },
  { name: 'Action', src: url('/images/clients/action.png') },
  { name: 'Etos', src: url('/images/clients/etos.png') },
];
---

<BaseLayout
  title="Iwan Stepanova, brede SEO-specialist met GEO als scherpste punt"
  description="Brede SEO-specialist met GEO als scherpste onderscheidende punt. Beschikbaar voor interim- en freelanceopdrachten, remote of op locatie, voor bureaus, in-house teams en grotere merken."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-20 lg:py-32 bg-surface-alt dot-grid">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-accent/5 rounded-full blur-[120px]"
    >
    </div>

    <!-- Constellation SVG motif (top-right, desktop only) -->
    <svg
      class="hidden lg:block absolute top-12 right-16 pointer-events-none select-none"
      width="340"
      height="260"
      viewBox="0 0 340 260"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <line x1="170" y1="130" x2="60" y2="48" stroke="#C8A882" stroke-width="0.75" opacity="0.45" class="constellation-line" style="animation-delay: 0s"></line>
      <line x1="170" y1="130" x2="280" y2="62" stroke="#C8A882" stroke-width="0.75" opacity="0.45" class="constellation-line" style="animation-delay: 0.1s"></line>
      <line x1="170" y1="130" x2="305" y2="185" stroke="#C8A882" stroke-width="0.75" opacity="0.45" class="constellation-line" style="animation-delay: 0.2s"></line>
      <line x1="170" y1="130" x2="120" y2="220" stroke="#C8A882" stroke-width="0.75" opacity="0.45" class="constellation-line" style="animation-delay: 0.3s"></line>
      <line x1="170" y1="130" x2="42" y2="165" stroke="#C8A882" stroke-width="0.75" opacity="0.45" class="constellation-line" style="animation-delay: 0.4s"></line>
      <circle cx="170" cy="130" r="4.5" fill="#C8A882" opacity="0.65" class="constellation-node" style="--node-opacity: 0.65; animation-delay: 0.15s"></circle>
      <circle cx="60" cy="48" r="2.8" fill="#C8A882" opacity="0.50" class="constellation-node" style="--node-opacity: 0.50; animation-delay: 0.5s"></circle>
      <circle cx="280" cy="62" r="2.8" fill="#C8A882" opacity="0.50" class="constellation-node" style="--node-opacity: 0.50; animation-delay: 0.55s"></circle>
      <circle cx="305" cy="185" r="2.8" fill="#C8A882" opacity="0.50" class="constellation-node" style="--node-opacity: 0.50; animation-delay: 0.6s"></circle>
      <circle cx="120" cy="220" r="2.8" fill="#C8A882" opacity="0.50" class="constellation-node" style="--node-opacity: 0.50; animation-delay: 0.65s"></circle>
      <circle cx="42" cy="165" r="2.8" fill="#C8A882" opacity="0.50" class="constellation-node" style="--node-opacity: 0.50; animation-delay: 0.7s"></circle>
    </svg>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Text Content -->
        <div class="space-y-6 lg:space-y-8">
          <span class="section-label">SEO- en GEO-specialist</span>

          <h1
            class="font-semibold text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-[1.1] tracking-tight"
          >
            <span class="block font-display italic text-primary">Brede SEO,</span>
            <span class="block font-sans text-primary-light">met GEO als scherpste punt</span>
          </h1>

          <p class="font-sans text-lg lg:text-xl text-neutral-500 max-w-xl leading-relaxed">
            Ik help bureaus, in-house teams en grotere merken beter vindbaar te worden in Google
            en in AI-zoekmachines. Strategie en uitvoering, geen losse trucjes. Beschikbaar voor
            interim- en freelanceopdrachten.
          </p>

          <div class="flex flex-wrap gap-4 items-center">
            <Button href={url('/contact/')} variant="primary" size="lg">
              Plan een gesprek
            </Button>
            <Button href={url('/diensten/')} variant="outline" size="lg">
              Bekijk mijn diensten
            </Button>
          </div>

          <p class="font-mono text-xs text-neutral-500 uppercase tracking-widest">
            Beschikbaar voor interim en freelance. Remote of op locatie.
          </p>
        </div>

        <!-- Image -->
        <div class="relative">
          <div class="absolute inset-0 bg-accent/5 rounded-2xl blur-3xl"></div>
          <div
            class="relative bg-surface rounded-2xl border border-neutral-300 overflow-hidden shadow-soft"
          >
            <img src={url('/images/iwan.png')} alt="Iwan Stepanova" class="w-full h-auto" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logos -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="text-center mb-10">
        <span class="section-label">Gewerkt aan SEO voor merken als</span>
      </div>

      <div class="relative overflow-hidden">
        <div
          class="absolute left-0 top-0 bottom-0 w-20 bg-gradient-to-r from-surface to-transparent z-10"
        >
        </div>
        <div
          class="absolute right-0 top-0 bottom-0 w-20 bg-gradient-to-l from-surface to-transparent z-10"
        >
        </div>
        <div class="animate-marquee flex items-center gap-12">
          {
            [...clientLogos, ...clientLogos].map((client) => (
              <div class="flex-shrink-0 flex items-center justify-center px-6 py-4">
                <img
                  src={client.src}
                  alt={client.name}
                  class="max-h-12 w-auto object-contain"
                  loading="lazy"
                />
              </div>
            ))
          }
        </div>
      </div>

      <p class="text-center font-sans text-sm text-neutral-500 mt-8 max-w-2xl mx-auto leading-relaxed">
        Werk aan merken als L'Oréal, ANWB, Etos, Action, Interpolis en Papa John's, uitgevoerd
        binnen bureauwerk, waaronder bij het grootste marketingbureau van de Benelux.
      </p>
    </div>
  </section>

  <!-- Wat ik doe -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Wat ik doe</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Brede SEO-specialist.</span>
          <span class="font-sans font-semibold text-primary-light">
            Content is mijn sterkste discipline.
          </span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Ik werk over de volle breedte van SEO. Technische audits, contentstrategie, on-page
            optimalisatie en GEO. Content is mijn sterkste discipline, technische SEO en
            linkbuilding beheers ik degelijk. Mijn achtergrond ligt in copywriting, en dat is de
            reden dat de inhoud altijd op orde is.
          </p>
          <p>
            Ik werk met een volledige toolset, onder andere Screaming Frog, Ahrefs, Semrush, Search
            Console, GA4 en GTM. Maar de kern is niet de tooling. De kern is de vertaling van
            analyse naar keuzes die een opdrachtgever begrijpt en kan uitvoeren. Ik leg SEO uit in
            gewone taal, zonder jargon om het jargon.
          </p>
          <p>
            De rode draad in mijn werk is dat ik geen losse trucjes lever maar strategie, en dat ik
            zelfstandig binnen een groter team of bureau kan opereren.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- GEO als scherpste punt -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">GEO, mijn scherpste punt</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Zichtbaar in AI-zoekresultaten.</span>
          <span class="font-sans font-semibold text-primary-light">
            Onderbouwd, niet hyperig.
          </span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            GEO staat voor zichtbaarheid in AI-zoekresultaten, in systemen als ChatGPT, Perplexity
            en Google AI Overviews. Ik ben een van de weinige Nederlandse specialisten met
            aantoonbare, praktische GEO-ervaring. Ik heb er honderden professionals in getraind en
            webinars over verzorgd voor externe bureaus.
          </p>
          <p>
            Wat mij hierin onderscheidt is niet dat ik GEO verkoop, maar dat ik er kritisch en
            onderbouwd over ben. De markt zit vol hype en onfalsifieerbare claims, zoals
            "marktleider in GEO". Mijn positie is nuchterder en op bewijs gebaseerd. Gestructureerde
            data en schema maken je vindbaar als entiteit, maar zorgen niet vanzelf voor een
            aanbeveling.
          </p>
          <p>
            Wat AI-systemen daadwerkelijk laat citeren is corroboratie buiten je eigen site.
            Merkvermeldingen op het bredere web, earned media, aanwezigheid op platforms zoals
            YouTube, en organische ranking. Die eerlijke, analytische lijn is zelf een
            onderscheidend punt.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Achtergrond en bewijs -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl mb-16">
        <span class="section-label">Achtergrond en bewijs</span>
        <h2 class="text-3xl lg:text-4xl mt-5 tracking-tight">
          <span class="font-display italic text-primary">Ruim drie jaar SEO,</span>
          <span class="font-sans font-semibold text-primary-light">
            deels op enterprise-niveau.
          </span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card card-signal">
          <h3 class="font-sans font-semibold text-xl text-primary mb-4">Enterprise-ervaring</h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Gewerkt bij meerdere bureaus, waaronder Youvia, onderdeel van FCR Media, het grootste
            marketingbureau van de Benelux. Daar deed ik enterprise SEO en werkte ik aan merken als
            L'Oréal, ANWB, Etos, Action, Interpolis en Papa John's.
          </p>
        </div>
        <div class="card card-signal">
          <h3 class="font-sans font-semibold text-xl text-primary mb-4">Honderden getraind</h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Honderden professionals getraind in GEO en webinars verzorgd voor externe bureaus. Ik
            breng de discipline niet alleen in de praktijk, ik leg hem ook uit aan vakgenoten.
          </p>
        </div>
        <div class="card card-signal">
          <h3 class="font-sans font-semibold text-xl text-primary mb-4">Operationele schaal</h3>
          <p class="font-sans text-neutral-500 leading-relaxed">
            Meer dan honderd Google Bedrijfsprofielen beheerd. Sinds begin 2026 werk ik fulltime als
            zelfstandige, na ruim drie jaar ervaring waarvan een deel op enterprise-niveau.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Voor wie -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Voor wie</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Bureaus, in-house teams</span>
          <span class="font-sans font-semibold text-primary-light">
            en grotere merken.
          </span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Ik werk voor bureaus, in-house marketingteams en grotere merken die tijdelijk of op
            projectbasis SEO- of GEO-expertise nodig hebben. Dat is een publiek dat zoekt naar
            bewezen ervaring op schaal, een scherpe visie, en het vertrouwen dat ik zelfstandig
            binnen een groter team kan opereren.
          </p>
          <p>
            Dat vertrouwen is verdiend in de praktijk. Ik stap in waar de capaciteit of de
            specialistische kennis tijdelijk ontbreekt, lever strategie en uitvoering, en draag het
            werk zo over dat het team er zelf mee verder kan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Beschikbaarheid -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Beschikbaarheid</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Beschikbaar voor interim</span>
          <span class="font-sans font-semibold text-primary-light">
            en freelance.
          </span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Ik ben beschikbaar voor interim- en freelanceopdrachten in SEO en GEO, niet gebonden aan
            een specifieke niche. Ik werk zowel remote als op locatie, en ik sta open voor langere
            interim-trajecten en voor projectwerk.
          </p>
          <p>
            Zoek je tijdelijke SEO- of GEO-capaciteit voor een team, een merk of een klanttraject,
            dan is een kort gesprek de snelste manier om te zien of het past.
          </p>
        </div>
        <div class="mt-10">
          <Button href={url('/contact/')} variant="primary" size="lg">
            Plan een gesprek
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Over -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Over Iwan</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">Van copywriter naar</span>
          <span class="font-sans font-semibold text-primary-light">
            brede SEO- en GEO-specialist.
          </span>
        </h2>
        <div class="font-sans text-neutral-500 space-y-5 leading-relaxed text-lg">
          <p>
            Ik begon op mijn zeventiende als freelance copywriter en ben van daaruit doorgegroeid
            naar SEO. Die achtergrond in taal en inhoud is de reden dat content een van mijn
            sterkste kanten is gebleven, ook toen het werk technischer en breder werd.
          </p>
          <p>
            Bij meerdere bureaus, waaronder het grootste marketingbureau van de Benelux, deed ik
            enterprise SEO en specialiseerde ik me in GEO. Sinds begin 2026 werk ik fulltime als
            zelfstandige.
          </p>
        </div>
        <div class="mt-8">
          <a
            href={url('/over/')}
            class="inline-flex items-center gap-2 font-sans text-primary-light hover:text-primary transition-colors duration-300"
          >
            Lees meer over mij
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Voor bureaus -->
  <section class="signal-section bg-surface-alt dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="section-label">Voor bureaus</span>
        <h2 class="text-3xl lg:text-4xl mt-5 mb-8 tracking-tight">
          <span class="font-display italic text-primary">SEO- en GEO-capaciteit</span>
          <span class="font-sans font-semibold text-primary-light"> onder jullie eigen merk.</span>
        </h2>
        <p class="font-sans text-neutral-500 leading-relaxed text-lg">
          Voor bureaus die tijdelijk een brede SEO-specialist of GEO-expertise nodig hebben, neem ik
          losse opdrachten of doorlopende samenwerkingen aan. Technische audits, contentstrategie,
          GEO-trajecten, of het meedraaien in een lopend klantteam. Korte lijnen, en discretie waar
          nodig.
        </p>
        <div class="mt-8">
          <a
            href={url('/diensten/voor-bureaus/')}
            class="inline-flex items-center gap-2 font-sans text-primary-light hover:text-primary transition-colors duration-300"
          >
            Meer over samenwerken met bureaus
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Slot CTA -->
  <section class="signal-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div
        class="relative bg-surface-alt rounded-2xl border border-neutral-300 p-10 lg:p-16 text-center overflow-hidden shadow-soft"
      >
        <div
          class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-accent/10 rounded-full blur-[100px]"
        >
        </div>

        <div class="relative">
          <h2 class="text-3xl lg:text-4xl xl:text-5xl tracking-tight">
            <span class="font-display italic text-primary">Op zoek naar tijdelijke</span>
            <span class="font-sans font-semibold text-primary-light">
              SEO- of GEO-capaciteit?
            </span>
          </h2>
          <p class="font-sans text-neutral-500 mt-6 max-w-2xl mx-auto leading-relaxed text-lg">
            Een eerste gesprek kost een half uur en levert je een scherpe inschatting op van waar de
            kansen liggen en hoe ik zou instappen. Geen verkooppraatje.
          </p>
          <div class="mt-8 flex justify-center">
            <Button href={url('/contact/')} variant="primary" size="lg">
              Plan een gesprek
            </Button>
          </div>
          <p class="font-mono text-xs text-neutral-500 uppercase tracking-widest mt-6">
            Beschikbaar voor interim en freelance. Remote of op locatie.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
