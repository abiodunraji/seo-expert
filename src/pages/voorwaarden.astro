---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Voorwaarden"
  description="Algemene voorwaarden van iwanstepanova.com."
>
  <section class="signal-section bg-surface">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <span class="section-label">Juridisch</span>
      <h1 class="text-3xl lg:text-4xl xl:text-5xl mt-5 mb-8 tracking-tight">
        <span class="font-display italic text-primary">Algemene</span>
        <span class="font-sans font-semibold text-primary-light"> voorwaarden</span>
      </h1>
      <div class="font-sans text-neutral-500 space-y-5 leading-relaxed">
        <p>
          De definitieve algemene voorwaarden worden op dit moment opgesteld. Voor specifieke
          afspraken over een samenwerking ontvang je vooraf een opdrachtbevestiging waarin de
          voorwaarden helder staan.
        </p>
        <p>
          Vragen tot die tijd? Stuur een bericht naar
          <a
            href="mailto:hallo@iwanstepanova.com"
            class="text-primary underline decoration-accent/40 hover:decoration-accent transition-colors"
          >
            hallo@iwanstepanova.com
          </a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
