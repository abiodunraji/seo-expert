---
// Formspree form ID for iwanstepanova.com (notifications -> hallo@iwanstepanova.com).
// Public by design — it ships in the page HTML — so it's safe to hardcode as the
// default. PUBLIC_FORMSPREE_FORM_ID still overrides it if set in the build env.
const FORMSPREE_FORM_ID = import.meta.env.PUBLIC_FORMSPREE_FORM_ID ?? 'mnjywjew';
const formAction = `https://formspree.io/f/${FORMSPREE_FORM_ID}`;

interface Props {
  formId?: string;
}

const { formId = 'contact-form' } = Astro.props;
---

<form
  id={formId}
  class="space-y-5"
  novalidate
  action={formAction}
  method="POST"
  data-formspree-configured={FORMSPREE_FORM_ID !== 'YOUR_FORMSPREE_FORM_ID'}
>
  <!-- Honeypot field for spam protection (Formspree also strips _gotcha submissions) -->
  <div class="hidden" aria-hidden="true">
    <label for="_gotcha">
      Do not fill this out
      <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <!-- Formspree subject line in the email Iwan receives -->
  <input
    type="hidden"
    name="_subject"
    value="Nieuw bericht via iwanstepanova.com"
  />

  <!-- Naam -->
  <div>
    <label for="name" class="font-sans text-sm text-neutral-500 block mb-2">Naam *</label>
    <input
      type="text"
      id="name"
      name="name"
      class="w-full bg-surface-alt border border-neutral-300 rounded-lg px-4 py-3 font-sans text-primary placeholder-neutral-500/50 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/25 transition-all duration-300"
      placeholder="Jouw naam"
      required
      minlength="2"
      maxlength="100"
      autocomplete="name"
    />
    <p class="error-message font-sans text-xs text-red-500 mt-1.5 hidden"></p>
  </div>

  <!-- Bedrijfsnaam -->
  <div>
    <label for="company" class="font-sans text-sm text-neutral-500 block mb-2">
      Bedrijfsnaam *
    </label>
    <input
      type="text"
      id="company"
      name="company"
      class="w-full bg-surface-alt border border-neutral-300 rounded-lg px-4 py-3 font-sans text-primary placeholder-neutral-500/50 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/25 transition-all duration-300"
      placeholder="Naam van je bedrijf"
      required
      minlength="1"
      maxlength="100"
      autocomplete="organization"
    />
    <p class="error-message font-sans text-xs text-red-500 mt-1.5 hidden"></p>
  </div>

  <!-- E-mailadres -->
  <div>
    <label for="email" class="font-sans text-sm text-neutral-500 block mb-2">E-mailadres *</label>
    <input
      type="email"
      id="email"
      name="email"
      class="w-full bg-surface-alt border border-neutral-300 rounded-lg px-4 py-3 font-sans text-primary placeholder-neutral-500/50 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/25 transition-all duration-300"
      placeholder="jouw@email.nl"
      required
      maxlength="254"
      autocomplete="email"
    />
    <p class="error-message font-sans text-xs text-red-500 mt-1.5 hidden"></p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <!-- Telefoon -->
    <div>
      <label for="phone" class="font-sans text-sm text-neutral-500 block mb-2">Telefoon</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        class="w-full bg-surface-alt border border-neutral-300 rounded-lg px-4 py-3 font-sans text-primary placeholder-neutral-500/50 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/25 transition-all duration-300"
        placeholder="06 12 34 56 78"
        maxlength="40"
        autocomplete="tel"
      />
      <p class="error-message font-sans text-xs text-red-500 mt-1.5 hidden"></p>
    </div>

    <!-- Website -->
    <div>
      <label for="company_website" class="font-sans text-sm text-neutral-500 block mb-2">
        Website
      </label>
      <input
        type="url"
        id="company_website"
        name="company_website"
        class="w-full bg-surface-alt border border-neutral-300 rounded-lg px-4 py-3 font-sans text-primary placeholder-neutral-500/50 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/25 transition-all duration-300"
        placeholder="https://jouwbedrijf.nl"
        maxlength="200"
        autocomplete="url"
      />
      <p class="error-message font-sans text-xs text-red-500 mt-1.5 hidden"></p>
    </div>
  </div>

  <!-- Bericht -->
  <div>
    <label for="message" class="font-sans text-sm text-neutral-500 block mb-2">
      Waar kan ik je mee helpen? *
    </label>
    <textarea
      id="message"
      name="message"
      rows="5"
      class="w-full bg-surface-alt border border-neutral-300 rounded-lg px-4 py-3 font-sans text-primary placeholder-neutral-500/50 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/25 transition-all duration-300 resize-none"
      placeholder="Bijvoorbeeld: ik wil weten waar mijn bedrijf staat in local SEO, of: we overwegen een langdurig traject"
      required
      minlength="10"
      maxlength="2000"></textarea>
    <p class="error-message font-sans text-xs text-red-500 mt-1.5 hidden"></p>
  </div>

  <button
    type="submit"
    id="submit-btn"
    class="w-full bg-primary text-white font-sans font-medium text-sm py-4 rounded-lg transition-all duration-300 hover:bg-primary-light hover:shadow-medium disabled:opacity-50 disabled:cursor-not-allowed btn-amber-glow"
  >
    <span class="btn-text">Verstuur</span>
    <span class="btn-loading hidden">Verzenden...</span>
  </button>

  <p class="font-sans text-xs text-neutral-500/70 text-center">
    Je hoort binnen één werkdag van mij.
  </p>

  <!-- Status Messages -->
  <div
    id="form-success"
    class="hidden bg-green-50 border border-green-200 rounded-lg px-4 py-3"
    role="status"
    aria-live="polite"
  >
    <p class="font-sans text-sm text-green-700">
      Bedankt voor je bericht. Ik laat binnen één werkdag van me horen.
    </p>
  </div>

  <div
    id="form-error"
    class="hidden bg-red-50 border border-red-200 rounded-lg px-4 py-3"
    role="alert"
    aria-live="assertive"
  >
    <p class="font-sans text-sm text-red-700" id="form-error-message">
      Er is iets misgegaan. Probeer het opnieuw of mail direct naar hallo@iwanstepanova.com.
    </p>
  </div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = submitBtn.querySelector('.btn-text') as HTMLElement;
  const btnLoading = submitBtn.querySelector('.btn-loading') as HTMLElement;
  const successMsg = document.getElementById('form-success') as HTMLElement;
  const errorMsg = document.getElementById('form-error') as HTMLElement;
  const errorMessage = document.getElementById('form-error-message') as HTMLElement;

  const formspreeConfigured = form.dataset.formspreeConfigured === 'true';

  function isValidEmail(email: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function showFieldError(field: HTMLElement, message: string): void {
    const errorEl = field.parentElement?.querySelector('.error-message');
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
    field.classList.add('border-red-500');
  }

  function clearFieldError(field: HTMLElement): void {
    const errorEl = field.parentElement?.querySelector('.error-message');
    if (errorEl) {
      errorEl.textContent = '';
      errorEl.classList.add('hidden');
    }
    field.classList.remove('border-red-500');
  }

  function validateForm(): boolean {
    let isValid = true;
    const name = document.getElementById('name') as HTMLInputElement;
    const company = document.getElementById('company') as HTMLInputElement;
    const email = document.getElementById('email') as HTMLInputElement;
    const message = document.getElementById('message') as HTMLTextAreaElement;

    [name, company, email, message].forEach(clearFieldError);

    if (!name.value.trim() || name.value.trim().length < 2) {
      showFieldError(name, 'Naam is verplicht (minimaal 2 tekens)');
      isValid = false;
    }

    if (!company.value.trim()) {
      showFieldError(company, 'Bedrijfsnaam is verplicht');
      isValid = false;
    }

    if (!email.value.trim() || !isValidEmail(email.value.trim())) {
      showFieldError(email, 'Voer een geldig e-mailadres in');
      isValid = false;
    }

    if (!message.value.trim() || message.value.trim().length < 10) {
      showFieldError(message, 'Vertel kort waar je mee geholpen wilt worden (minimaal 10 tekens)');
      isValid = false;
    }

    return isValid;
  }

  form.addEventListener('submit', async (e: Event) => {
    e.preventDefault();

    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    if (!validateForm()) return;

    if (!formspreeConfigured) {
      errorMsg.classList.remove('hidden');
      errorMessage.textContent =
        'Het formulier is nog niet geconfigureerd. Mail direct naar hallo@iwanstepanova.com.';
      return;
    }

    submitBtn.disabled = true;
    btnText.classList.add('hidden');
    btnLoading.classList.remove('hidden');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });

      if (response.ok) {
        successMsg.classList.remove('hidden');
        form.reset();
      } else {
        const data = (await response.json().catch(() => null)) as { errors?: { message: string }[] } | null;
        const msg = data?.errors?.[0]?.message ?? 'Er is iets misgegaan. Probeer het opnieuw.';
        throw new Error(msg);
      }
    } catch (error) {
      errorMsg.classList.remove('hidden');
      errorMessage.textContent =
        error instanceof Error
          ? error.message
          : 'Er is iets misgegaan. Probeer het opnieuw of mail direct naar hallo@iwanstepanova.com.';
    } finally {
      submitBtn.disabled = false;
      btnText.classList.remove('hidden');
      btnLoading.classList.add('hidden');
    }
  });

  ['name', 'company', 'email', 'phone', 'company_website', 'message'].forEach((id) => {
    const el = document.getElementById(id);
    el?.addEventListener('input', () => clearFieldError(el as HTMLElement));
  });
</script>
